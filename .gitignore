# NOTE FOR CONTRIBUTORS
# We ignore most of .claude workspace internals, but we intentionally track
# .claude/skills/** because SKILL playbooks are project source artifacts.
# Keep the pair below together:
#   .claude/*
#   !.claude/skills/**
# If you change these lines, verify SKILL files still appear in git status.

# OS and editor
.DS_Store
.vscode/

# Environments and local secrets
.env
.env.*
!.env.example
.venv/
ENV/
env/
venv/

# Python caches and compiled artifacts
__pycache__/
*.py[cod]
*.so

# Python build and packaging outputs
.eggs/
*.egg
*.egg-info/
build/
dist/
pip-wheel-metadata/
site/

# Python tooling and test outputs
.coverage*
.hypothesis/
.mypy_cache/
.nox/
.pyre/
.pytest_cache/
.pytype/
.ruff_cache/
.tox/
htmlcov/

# Jupyter
.ipynb_checkpoints/

# Frontend dependencies and build cache
**/.vite/
bower_components/
node_modules/

# Databricks and MLflow local artifacts
.databricks/
**/.databricks
**/mlruns/
.databricks_app_source/wheels/*.whl
!.databricks_app_source/wheels/.gitkeep
load-test-runs/

# Logs and local runtime output
*.log
logs/

# Documentation build output
docs/_build/

# Agent workspace internals
.claude/*
!.claude/skills/
!.claude/skills/**

# Chainlit auto-generated config and runtime files
.chainlit/
chainlit.md
