{
  "name": "multiagent-reactui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{json,ts}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{json,ts}\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@playwright/test": "^1.52.0",
    "prettier": "^3.5.3",
    "typescript": "^5.6.3",
    "vite": "^8.1.3"
  }
}
